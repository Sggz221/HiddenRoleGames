# Copy to .env for local development. Validated with Zod on server start.
# Never commit real secrets.

NODE_ENV=development
# Railway injects PORT in production. Locally the server listens here.
PORT=3000
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000
# Optional
SENTRY_DSN=

# Local infra: `pnpm infra:up` (docker compose). Both are optional: without them the
# server keeps games in memory and does not store history.
DATABASE_URL=postgres://aullidos:aullidos@localhost:5432/aullidos
REDIS_URL=redis://localhost:6379
GAME_SNAPSHOT_TTL_SECONDS=21600
# Lobby seats are held this long after a disconnection (games keep the seat).
RECONNECT_GRACE_SECONDS=60

# --- Accounts (next milestone) ---
# SESSION_SECRET=change-me
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
