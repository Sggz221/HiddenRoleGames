# Copy to .env for local development. Validated with Zod on server start.
# Never commit real secrets.

NODE_ENV=development
# Railway injects PORT in production. Locally the server listens here.
PORT=3000
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000
# Optional
SENTRY_DSN=

