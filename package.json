{
  "name": "aullidos",
  "private": true,
  "description": "Juego web multijugador de rol oculto (monorepo)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "docker:build": "docker compose --profile app build",
    "docker:up": "docker compose --profile app up --build",
    "docker:down": "docker compose --profile app down",
    "prepare": "lefthook install",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose --profile app down",
    "db:generate": "pnpm --filter @aullidos/server db:generate",
    "db:migrate": "pnpm --filter @aullidos/server db:migrate",
    "db:studio": "pnpm --filter @aullidos/server db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.1",
    "turbo": "2.11.7",
    "railway": "3.13.1"
  }
}
